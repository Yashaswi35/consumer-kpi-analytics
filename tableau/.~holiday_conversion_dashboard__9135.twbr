  <worksheets>
    <worksheet name='Device'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Every device fell together, so device mix did not drive the drop</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>.</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Tablet is about 2% of sessions (roughly 600 a week), so its weekly rate is noisy. Desktop and mobile, about 98% of sessions, move together.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='device_weekly (dashboard_data)' name='federated.1ad3mec02u78am17jp8pm0ofcreh' />
